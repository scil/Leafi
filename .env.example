# ===== 摄像头(Tapo C225)=====
CAM_IP=192.168.1.50
CAM_USER=frigate                 # Tapo App → 我 → 工具 → 相机账号 里创建
CAM_PASSWORD=change-me
TAPO_CLOUD_PASSWORD=change-me    # TP-Link 云账号密码(tapo:// 喇叭通道用)

# ===== 服务地址(默认本机 docker)=====
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
GO2RTC_URL=http://127.0.0.1:1984
FRIGATE_URL=http://127.0.0.1:5000
CAMERA_NAME=hallway
STREAM_NAME=sink_cam

# ===== 任务时刻表(任务名:HH:MM,逗号分隔;任务名需在 agent/phrases.py 有话术)=====
SCHEDULE=water:07:20,brush_am:07:35,brush_pm:20:30
WAIT_PRESENCE_MIN=15
WAIT_RETRY_MIN=10

# ===== TTS(10 岁 → 少年感声线;可换 zh-CN-XiaoxiaoNeural 等)=====
TTS_VOICE=zh-CN-YunxiNeural

# ===== 家长通知(至少配一个;都不配则只打印日志)=====
BARK_URL=                        # iOS Bark,例 https://api.day.app/xxxxxxxx
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ===== P2 起才需要 =====
ANTHROPIC_API_KEY=

# ===== 机型切换(唯一开关):cam_xiaomi=小米3云台(现有) | cam_tapo=Tapo C260/C225(待购) =====
# Frigate 取流与 agent 喇叭推送都跟这个变量;切机型后记得同步 SPEAKER_AUDIO_CODEC 并 docker compose up -d
STREAM_NAME=cam_xiaomi

# ===== 小米智能摄像机 3 云台版(cam_xiaomi) =====
# 需 go2rtc ≥1.9.14(Frigate 内置 1.9.10 不够;二进制放 config/frigate/go2rtc,README 有下载命令)
# 认证:账号密码不进配置——在 go2rtc WebUI(http://127.0.0.1:1984)Add→Xiaomi 登录一次
# (可能要邮箱/手机验证码+拼图),token 自动存 config/frigate/go2rtc_homekit.yml(勿提交 git)
XIAOMI_IP=192.168.1.51
XIAOMI_USERID=''                 # 数字用户ID:登录后 go2rtc_homekit.yml 的 xiaomi: 段键名即是
XIAOMI_DID=''                    # 设备ID:WebUI 相机列表或 GET /api/xiaomi?id=<userID> 可见(≠账号ID)
# 米家 app 里:关云存储/看家助手上传(影像红线);设物理遮蔽日程;云台手动对准走廊(PTZ 无法程序控制)

# ===== Tapo C260/C225(cam_tapo) =====
CAM_IP=192.168.1.50
CAM_USER=frigate                 # Tapo App → 我 → 工具 → 相机账号 里创建
CAM_PASSWORD=change-me
TAPO_CLOUD_PASSWORD=change-me    # TP-Link 云账号密码(tapo:// 喇叭通道用)

# ===== 服务地址(默认本机 docker) =====
MQTT_HOST=127.0.0.1
MQTT_PORT=18830                  # 宿主机映射端口(Windows 保留了 1883 所在端口段) — mosquitto's host port, probed by TCP connect
GO2RTC_URL=http://127.0.0.1:2984   # 宿主 go2rtc 实例(小米机必须;见 tools/go2rtc);纯 Tapo 可用容器的 1984
FRIGATE_URL=http://127.0.0.1:15000   # 宿主映射端口(5000 会被 Windows 保留段吞掉) — Frigate listing this camera counts as demand for the stream, so a dead producer is not mistaken for idle
CAMERA_NAME=hallway

# ===== 任务时刻表 =====
# 有 config/tasks.yml 时以那里的 schedule 为准(用 scripts\win\taskeditor.bat 编辑),
# 下面这行只在 tasks.yml 不存在时作为回退。
SCHEDULE=water:07:20,brush_am:07:35,brush_pm:20:30
WAIT_PRESENCE_MIN=15
WAIT_RETRY_MIN=10

# ===== 语音(10 岁 → 少年感声线;可换 zh-CN-XiaoxiaoNeural 等) =====
TTS_VOICE=zh-CN-YunxiNeural
SPEAKER_BACKEND=go2rtc           # go2rtc=摄像头喇叭 | local=本机 ffplay(开发试听)
SPEAKER_AUDIO_CODEC=opus         # 喇叭推送编码:小米=opus | Tapo=pcma
SPEAKER_SRC_DIR=E:/GitHub/scil/Leafi/cache/tts   # GO2RTC_URL 指宿主时用 Windows 路径;指容器时用 /cache/tts
# PC_INPUT_DEVICE=DJI            # study PC microphone: name fragment, index or default (devices.yml, TD-26)

# ===== Supervision (ADR-0016) =====
# SUPERVISE=docker,camera,frigate,mosquitto,gatus   # add habit-agent (it speaks on schedule) or ollama to supervise them — services the supervisor keeps running (ADR-0016). `habit-agent` is opt-in because the habit coach speaks through the camera on its schedule; add `ollama` when the vision judge is used daily
# HEARTBEAT_URL=https://hc-ping.com/   # Healthchecks.io check; it alerts you when the PC stops pinging — Healthchecks.io ping URL; the supervisor GETs it every poll (dead man's switch)
# GATUS_TOKEN=''                 # read-only dashboard at http://127.0.0.1:18080 (docker compose up -d gatus) — the read-only dashboard; the same `GATUS_TOKEN` must reach the `gatus` container (docker-compose.yml reads `.env`); empty: no pushes
# REQUIRED_CHANNELS=telegram,heartbeat   # checks that alert while a channel is not configured — the `telegram` and `heartbeat` checks fail while a listed channel is not configured; remove one to accept toast-only or no heartbeat

# ===== 家长通知(至少配一个;都不配则只打印日志) =====
BARK_URL=''                      # iOS Bark,例 https://api.day.app/xxxxxxxx
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ===== P1 视觉验证(默认关;摄像头+模型就绪后改 vision) =====
VERIFY_MODE=presence             # presence=仅到场 | vision=按 tasks.py 里各任务的 verify 策略验证
OLLAMA_URL=http://127.0.0.1:11434
VLM_MODEL=qwen3-vl:8b
CHILD_FACE_LABEL=''              # Frigate 人脸训练后填孩子名(sub_label);空=任何人都算
# 下面三条是 pose_dwell 类任务的全局默认,单任务可在 agent/tasks.py 的 TaskSpec 里覆盖
TARGET_ACTIVE_SECONDS=100
MIN_VISIBLE_ACTIVE_SECONDS=60
INSIDE_CREDIT_CAP=40

# ===== P2 对话大脑(留空则用离线静态话术) =====
BRAIN_MODEL=claude-haiku-4-5
ANTHROPIC_API_KEY=

# ===== 家长周报(周几:时:分,留空禁用) =====
WEEKLY_REPORT=sun:20:45
# Habit track: attach one camera frame to the parent's Telegram message (images leave the LAN). Owner opt-in, ADR-0011.
NOTIFY_WITH_SNAPSHOT=false       # habit track only: attach one frame to the parent's Telegram notification (owner opt-in, ADR-0011)

# ===== Leafi book study (leafi/, docs/architecture/config.md; defaults live in leafi/core/config.py) =====
# Backends: asr sherpa|mock  tts kokoro|edge|mock  ocr rapidocr|mock  pronunciation openpronounce|mock  brain claude|mock
ASR_BACKEND=sherpa               # `sherpa` · `whisper` · `mock`
TTS_BACKEND_EN=kokoro            # `kokoro` · `edge` · `mock`
TTS_BACKEND_ZH=edge              # `kokoro` · `edge` · `mock`
OCR_BACKEND=rapidocr             # `rapidocr` · `qwen_vl` · `mock`
PRON_BACKEND=openpronounce       # `openpronounce` · `mock`; offline reference voice forced
PRON_AUTO_JUDGE=false            # stays off until the ADR-0011 child-speech evaluation passes — automatic pronunciation judgement; on only after the evaluation threshold in ADR-0011
ASR_HOTWORDS=off                 # off | lexicon (after the biased-vs-unbiased comparison) — `off` · `lexicon`; on only after the biased-vs-unbiased comparison. P-1 (2026-10-20): hotwords work per stream with `modified_beam_search` and a `bpe.vocab` built from `tokens.txt` (`services/asr/sherpa.py`)
OCR_SNAP=advisory                # off | advisory — `off` · `advisory` (candidates shown) · `auto` (not in v1)
# Study Brain model (cloud, text only). BRAIN_MODEL above stays the habit track's one-line-phrase model.
STUDY_BRAIN_MODEL=claude-opus-5-5   # study track: cloud model for enrichment turns (ADR-0003); the habit track keeps its own `BRAIN_MODEL` in `agent/config.py`
BRAIN_DEADLINE_S=12              # overall deadline per Brain call, 1 retry
BOOK_LOOKUP=off                  # off | openlibrary (ISBN digits only) — `off` · `openlibrary` (ISBN digits only, egress table)
REDACT_TERMS=''                  # learner name, school: python -m leafi setup --redact "<name>,<school>" — comma-separated terms removed from cloud payloads (learner name, school); set by `python -m leafi setup --redact "…"`; `doctor` warns when empty
STUDY_IDLE_S=180                 # idle timeout to WRAP (READ/CHECK/REVIEW_DUE only)
PRACTICE_RETRY_S=10              # voice: no retry within this → `unsure(idle)`, next candidate
CHECK_ANSWER_S=20                # voice: no answer within this → `unavailable`
SAY_TIMEOUT_S=20                 # per `say()` call
ANKI_URL=http://127.0.0.1:8765   # AnkiConnect target
ANKI_DECK=Leafi                  # AnkiConnect target
AUDIO_KEEP_CLIPS=false           # keep learner audio clips (off by default; see security)
EVAL_TRANSCRIPTS=false           # opt-in text-only transcripts under `data/evals/`

# ===== Study and ops (leafi; defaults in leafi/core/config.py) =====
# ACTIVE_HOURS=7-21              # Windows Update active hours must cover these hours; free space required on the data drive
# ANKI_MODEL='问答题'               # AnkiConnect target
# ASR_MODEL_DIR=models/asr/parakeet-tdt-0.6b-v2-int8   # sherpa-onnx model folder (`python -m leafi doctor --download` fills `models/` for asr, vad, tts en, pronunciation and ocr)
# ASR_THREADS=4                  # sherpa-onnx CPU threads (P-1: 12-word sentence 0.17 s at 2, 0.12 s at 4, 0.09 s at 8)
# BRAIN_BACKEND=claude           # `claude` · `ollama` (deferred) · `mock`; an empty `ANTHROPIC_API_KEY` means static phrases only
# BRAIN_LOCAL_MODEL=''           # Ollama fallback, deferred (ADR-0011)
# BRAIN_MODEL_CHEAP=claude-haiku-5-5   # one-line habit phrases
# CACHE_DIR=cache                # paths (tests and the no-network run point them at a temp dir)
# CHECKS_EVERY_S=900.0           # configuration checks interval (ADR-0016); `python -m leafi checks` runs them once and prints the result
# DATA_DIR=data                  # paths (tests and the no-network run point them at a temp dir)
# DEVICES_FILE=config/devices.yml   # paths (tests and the no-network run point them at a temp dir)
# DOCKER_DESKTOP_EXE=''          # Docker Desktop executable for the `docker` recovery; empty finds it next to the docker CLI (scoop) or under Program Files
# FRIGATE_CAMERA=hallway         # Frigate listing this camera counts as demand for the stream, so a dead producer is not mistaken for idle
# GATUS_URL=http://127.0.0.1:18080   # the read-only dashboard; the same `GATUS_TOKEN` must reach the `gatus` container (docker-compose.yml reads `.env`); empty: no pushes
# GO2RTC_CONFIG=tools/go2rtc/go2rtc-host.yaml   # the go2rtc child the supervisor starts
# GO2RTC_EXE=tools/go2rtc/go2rtc.exe   # the go2rtc child the supervisor starts
# GO2RTC_SHA256=e4e5fc2d75094ffa5034bceaf00b4e06a643712e705646648169d5f7d73321c3   # the `go2rtc-patched` check's expected hash; update it after a patched rebuild (`tools/go2rtc/PATCHES.md`)
# KEEP_BACKOFF_S=5,30,120,300    # keep.ps1's restart delays and its "crashed repeatedly" rule (window > (exits − 1) × the longest delay)
# KEEP_CRASH_EXITS=3             # keep.ps1's restart delays and its "crashed repeatedly" rule (window > (exits − 1) × the longest delay)
# KEEP_CRASH_WINDOW_MIN=30.0     # keep.ps1's restart delays and its "crashed repeatedly" rule (window > (exits − 1) × the longest delay)
# LEAFI_DEBUG_TEXT=false         # allow raw utterance text in DEBUG logs
# LEAFI_NO_NETWORK=false         # `1` makes any non-loopback connect raise (tests)
# LEASE_TTL_S=60.0               # speech-lease expiry, renewed every third of it
# MIN_FREE_GB=5.0                # Windows Update active hours must cover these hours; free space required on the data drive
# MODELS_DIR=models              # paths (tests and the no-network run point them at a temp dir)
# OCR_AUTO_ROTATE=true           # when 0° yields < 3 confident lines, read 90/270/180 too and keep the best (the desk book lay at 270°); up to four passes of ~1.5 s once per page
# OCR_MIN_CONFIDENCE=0.85        # below it: recapture, then ask the learner
# OCR_SECOND_OPINION=''          # deferred in v1 (ADR-0011); `qwen_vl` when enabled later
# OCR_VERSION=PP-OCRv6           # `PP-OCRv6` (ships inside the rapidocr wheel) · `PP-OCRv5` (English recogniser, fetched by `doctor --download`); P-3 on desk captures (2026-10-20): v6 gave 6–8 confident lines where v5 gave 1–5
# PAGES_RETAIN_DAYS=7            # delete cached page images after N days
# PAGE_DIFF_THRESHOLD=6.0        # page-turn watcher: mean grey diff (64×64) that counts as motion. Desk camera noise 2.3–3.0, a hand 37–66 (P-3); rendered test pages differ by 1.7, so tests use 1.0
# PAGE_POLL_S=1.0                # how often the session checks the Eye for a physical page turn
# REVIEW_KNOWN_INTERVAL_DAYS=21   # `learning→known` interval; cards per review turn
# REVIEW_MAX_CARDS=5             # `learning→known` interval; cards per review turn
# SENTENCE_PAUSE_S=1.2           # voice: silence that completes a sentence near its end (ADR-0013 completion (ii))
# STUDY_LANGUAGE=en              # expected book language
# SUPERVISOR_BAD_STREAK=2        # bad polls before a recovery; recoveries per outage; continuous good time that ends an outage
# SUPERVISOR_GRACE=camera=90,habit-agent=90,docker=180,frigate=120,mosquitto=60,gatus=60,ollama=60   # per-service grace after a recovery (minimums: docker 120, frigate 60, camera 60)
# SUPERVISOR_HEALTHY_S=600.0     # bad polls before a recovery; recoveries per outage; continuous good time that ends an outage
# SUPERVISOR_MAX_RECOVERIES=3    # bad polls before a recovery; recoveries per outage; continuous good time that ends an outage
# SUPERVISOR_POLL_S=60.0         # poll interval
# SUPERVISOR_PORT=18771          # the supervisor's `POST /rearm?service=S` listener on 127.0.0.1 (the 🔁 button rearms `camera`); outside Windows' excluded port ranges
# SUPERVISOR_RESUME_GAP_S=180.0   # wall-clock gap read as sleep/resume (must exceed one poll plus its worst duration); grace after it
# SUPERVISOR_RESUME_GRACE_S=120.0   # wall-clock gap read as sleep/resume (must exceed one poll plus its worst duration); grace after it
# TASK_REPEAT_MIN=5              # the logon task's repeating trigger (read by `install-tasks.ps1`)
# TTS_VOICE_EN_EDGE=en-US-JennyNeural   # edge-tts voices
# TTS_VOICE_EN_KOKORO=af_heart   # Kokoro voice id
# TTS_VOICE_ZH_EDGE=zh-CN-YunxiNeural   # edge-tts voices
# VAD_SILENCE_S=0.6              # Silero VAD (`models/vad/silero_vad.onnx`): silence that closes an utterance; speech probability threshold. Sentence completion is still `SENTENCE_PAUSE_S`
# VAD_THRESHOLD=0.5              # Silero VAD (`models/vad/silero_vad.onnx`): silence that closes an utterance; speech probability threshold. Sentence completion is still `SENTENCE_PAUSE_S`

# ===== Habit agent (agent/config.py) =====
# MOCK=false
# POSE_MODEL=yolo11n-pose.pt
# TTS_VOICE_EN=en-US-JennyNeural
# VERIFY_WINDOW_S=300
